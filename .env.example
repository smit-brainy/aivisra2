# ==============================================================================
# AIVISRA StreamCore Environment Configuration
# ==============================================================================
# Copy this template to .env and configure any local overrides:
#   cp .env.example .env
#
# SECURITY NOTICE:
#   - Never commit .env with real secrets to Git or GitHub.
#   - .env is included in .gitignore by default.
# ==============================================================================

# Optional: MediaMTX WebRTC and API base URLs (if different from app.yaml)
# MEDIAMTX_WEBRTC_BASE_URL=http://127.0.0.1:8889
# MEDIAMTX_API_URL=http://127.0.0.1:9997

# Optional: override the central SQLite database location.
# Defaults to backend/database.db next to the backend package, so the project
# can live under any absolute path.
# STREAMCORE_DB=backend/database.db
