# ==============================================================================
# AIVISRA StreamCore Environment Configuration
# ==============================================================================
# Copy this template to .env and configure your secret credentials:
#   cp .env.example .env
#
# SECURITY NOTICE:
#   - Never commit .env with real secrets to Git or GitHub.
#   - .env is included in .gitignore by default.
# ==============================================================================

# Google Gemini API Key for Level 2 Natural Language Surveillance Search
# Powers multimodal person descriptions and semantic embeddings (text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative env variable name for Google API key
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: MediaMTX WebRTC and API base URLs (if different from app.yaml)
# MEDIAMTX_WEBRTC_BASE_URL=http://127.0.0.1:8889
# MEDIAMTX_API_URL=http://127.0.0.1:9997

